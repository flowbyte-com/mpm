{
  "workspace": "~/.mpm",

  "profiles": {
    "default": {
      "provider": "minimax",
      "model": "MiniMax-M2.7",
      "base_url": "https://api.minimax.io/anthropic/v1",
      "api_key": "<set via: mpm config profile set default api_key>",
      "max_tokens": 4096,
      "timeout_seconds": 300
    },
    "embedding": {
      "provider": "ollama",
      "model": "nomic-embed-text",
      "base_url": "http://localhost:11434"
    }
  },

  "components": {
    "memory": "default",
    "critic": "default",
    "embedding": "embedding"
  }
}

# Build artifacts (compile via `npm install && npm run build`)
dist/
node_modules/

# Compiled test suite produced by `tsc -p tsconfig.tests.json`.
# The Makefile's test-agent-adapters gate runs the canonical gate's
# TS tests against `tests-build/`, which is generated on demand by
# the local node_modules/.bin/tsc — committing it would couple the
# source tree to a host-specific compile.
tests-build/

# TypeScript build info
*.tsbuildinfo

# OS / editor cruft
.DS_Store
.idea/
.vscode/

# package-lock.json IS committed (lockfileVersion 3, npm 7+).
# The Makefile's `test-agent-adapters` gate drives a local
# `./node_modules/.bin/tsc` and treats a missing local compiler
# as a hard FATAL; the canonical CI bootstrap therefore depends
# on `npm ci` (which requires a committed lockfile) on a fresh
# checkout. The pinned versions are recorded in package.json's
# devDependencies (`typescript`, `@types/node`); both packages
# have stable release policy and a `lockfileVersion: 3` lockfile
# makes the CI install byte-stable across npm 7/8/9/10. Regenerate
# with `npm install --package-lock-only` after any devDependency
# edit; do NOT hand-edit.

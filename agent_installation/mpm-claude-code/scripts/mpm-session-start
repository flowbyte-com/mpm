#!/usr/bin/env bash
# mpm-session-start — Claude Code SessionStart hook.
#
# Contract: emits a JSON envelope of shape
#   {"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"<wake>"}}
# to stdout. Claude Code parses this envelope and injects additionalContext into
# the model-facing system prompt before the first turn. Plain-prose stdout is
# silently dropped (verified empirically from the captured
# ~/.claude/projects/-tmp-TestDrillE2E-…/6ab98c14-…jsonl trace).
#
# Exit code is 0 on every code path. If anything fails we emit an empty
# additionalContext rather than blocking session start.

set -u

# Provenance from Claude Code runtime env (best-effort; all optional).
export MPM_PROVENANCE_FRAMEWORK="${MPM_PROVENANCE_FRAMEWORK:-claude-code}"
if [ -n "${CLAUDE_MODEL:-}" ]; then
  export MPM_PROVENANCE_MODEL="$CLAUDE_MODEL"
fi
if [ -n "${CLAUDE_INVOCATION_ID:-}" ]; then
  export MPM_PROVENANCE_INVOCATION_ID="$CLAUDE_INVOCATION_ID"
fi
if [ -n "${CLAUDE_SESSION_ID:-}" ]; then
  # Stage 2C.2: CLAUDE_SESSION_ID is Claude Code's native conversational
  # /session identity, NOT an invocation-lineage ancestor. It maps to the
  # canonical MPM_PROVENANCE_FRAMEWORK_SESSION_ID slot so the substrate
  # stamps it onto tool_invocations.framework_session_id and
  # session_handoffs.framework_session_id.
  # Parent-invocation lineage (MPM_PROVENANCE_PARENT_INVOCATION_ID) is
  # only set when Claude Code separately exposes a true causal parent
  # invocation identifier, which it does not today.
  export MPM_PROVENANCE_FRAMEWORK_SESSION_ID="$CLAUDE_SESSION_ID"
fi

# Workspace: prefer MPM_WORKSPACE (the host's own wiring), else the
# canonical user runtime at $HOME/.mpm.
#
# There is deliberately no "." last resort here. A previous version fell
# back to the current directory when $HOME/.mpm/src/db was absent, which
# made the hook point the whole session at whatever directory the user
# happened to launch from — the same ghost-workspace shape the Go
# resolvers carried. If the runtime root is genuinely missing, naming it
# anyway is correct: `mpm` will report what is absent, which is a
# diagnosable failure, rather than silently operating on a directory that
# was never a workspace.
if [ -z "${MPM_WORKSPACE:-}" ]; then
  export MPM_WORKSPACE="${HOME}/.mpm"
fi

# Locate the mpm binary. The hook MUST not block on a missing binary.
MPM_BIN="${MPM_BIN:-}"
if [ -z "$MPM_BIN" ]; then
  for candidate in \
    "${HOME}/.local/bin/mpm" \
    "${HOME}/.mpm/bin/mpm" \
    "/usr/local/bin/mpm" \
    "$(command -v mpm 2>/dev/null || true)"; do
    if [ -x "$candidate" ]; then
      MPM_BIN="$candidate"
      break
    fi
  done
fi

emit_envelope() {
  # emit_envelope "<string>"
  # JSON-escape the input and emit the Claude Code SessionStart envelope.
  python3 -c '
import json, sys
ctx = sys.argv[1] if len(sys.argv) > 1 else ""
sys.stdout.write(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": ctx,
    }
}))
' "$1"
}

if [ -z "$MPM_BIN" ]; then
  emit_envelope ""
  exit 0
fi

# Call the substrate. CD into the workspace so mpm can resolve relative paths.
WAKE_RAW=""
if [ -d "$MPM_WORKSPACE" ]; then
  WAKE_RAW=$(cd "$MPM_WORKSPACE" && "$MPM_BIN" call mpm_context \
    --payload '{"action":"read_wake_context","params":{"format":"system-prompt"}}' \
    2>/dev/null) || WAKE_RAW=""
fi

# Strip log lines and trailing log noise; keep only the JSON envelope.
# mpm prints log lines first, then a single JSON object on the last line(s).
WAKE_CONTENT=""
if [ -n "$WAKE_RAW" ]; then
  WAKE_CONTENT=$(printf '%s' "$WAKE_RAW" | python3 -c '
import json, re, sys
raw = sys.stdin.read()
if not raw.strip():
    sys.exit(0)
m = re.search(r"\{[\s\S]*\}", raw)
if not m:
    sys.exit(0)
try:
    d = json.loads(m.group(0))
except json.JSONDecodeError:
    sys.exit(0)
if not d.get("success"):
    sys.exit(0)
content = d.get("content")
if isinstance(content, str):
    sys.stdout.write(content)
') || WAKE_CONTENT=""
fi

# If content is missing, still emit an envelope (empty) — never block.
emit_envelope "${WAKE_CONTENT:-}"
exit 0

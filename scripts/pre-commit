#!/bin/sh
# Pre-commit hook: fail the commit if the source tree doesn't compile, or if
# the synthesis / reliability / lifecycle test suites regress.
#
# Rationale: the post-commit hook auto-pushes every commit to origin, so a
# broken commit lands on the shared remote within seconds. This pre-commit gate
# is the only thing standing between a WIP refactor and a noisy origin/main.
#
# Scope of this hook:
#   - go build ./...            (always — must compile)
#   - mpm-lint --gate           (when any .go file staged — all nine
#                                classification gates in one parse: scans,
#                                closes, tx, ctx, go, mutex, sql, fd,
#                                imports)
#   - synthesis/reliability/lifecycle tests  (these are deterministic; some
#     other test suites have pre-existing data-pollution failures we are not
#     fixing in this arc — those belong in a CI matrix, not a local gate)
#
# Install: copy this file to .git/hooks/pre-commit (or run `make install-hooks`).
# Future: when the test suite stabilises, add `go test ./...` (full sweep) and
# move the flaky tests into a separate CI job with -short + clean DB.

set -e

echo "[pre-commit] verifying build..."

# Resolve go binary (PATH may not be set inside git hooks)
GO="${GO:-$(command -v go || echo /usr/local/go/bin/go)}"

if [ ! -x "$GO" ]; then
  echo "[pre-commit] FATAL: go binary not found (tried: $GO)" >&2
  echo "[pre-commit] Set GO=/path/to/go and retry, or install go." >&2
  exit 1
fi

if ! "$GO" build ./...; then
  echo "[pre-commit] ABORTING commit: go build ./... failed." >&2
  echo "[pre-commit] Fix the build errors and stage the fixes before retrying." >&2
  exit 1
fi

echo "[pre-commit] build OK"

echo "[pre-commit] running consolidated mpm-lint audit gates (scans/closes/tx/ctx/go/mutex/sql/fd/imports)..."
# The consolidated mpm-lint gate replaces the eight standalone audit-*
# binaries (commit 1e2d517-era wiring). One parse, all rules concurrent:
#
#   - tx       keeps tx-commit-only / tx-no-rollback / tx-explicit-rollback /
#              tx-unknown at zero: an explicit-but-not-deferred Rollback leaks
#              the write transaction on every early return (handlers_backup,
#              handlers_gc, initUnifiedSchema were fixed on 2026-08-07).
#   - ctx      keeps ctx-in-scope-missing / unknown at zero (real drops) and
#              ratchets ctx-plain-missing / ctx-void from their baselines so
#              any NEW bare Query/Exec/QueryRow call fails the commit while
#              the pre-existing backlog (479/47 as of the consolidation) is
#              grandfathered.
#   - go       keeps go-detached / go-unknown at zero: an unbound goroutine
#              never returns its lifetime budget.
#   - mutex    keeps mu-no-unlock / mu-unknown at zero and ratchets
#              mu-explicit-unlock to its baseline: a Lock() without a
#              matching Unlock() on every path deadlocks the single shared
#              connection; the brief-critical-section idiom (14 sites) is
#              grandfathered while new non-deferred sites fail the commit.
#   - sql      keeps sql-built at zero (value injection / Sprintf panic
#              class) and ratchets sql-unknown / sql-fmt-safe / sql-const to
#              their baselines.
#   - fd       keeps fd-no-close / fd-remove-only at zero and ratchets
#              fd-explicit-close / fd-unknown to their baselines.
#   - imports  keeps import-forbidden at zero: the architecture boundary
#              enforcer (core-no-main / audit-no-core / libs-no-cmd) asserts
#              the internal/ dependency DAG stays acyclic — internal/core is
#              a standalone module (github.com/flowbyte-com/mpm-core) and must
#              never import the main module, libs under internal/ must never
#              reach into cmd/, and internal/audit can't depend on core.
#   - closes   keeps no-close / rows-discarded / loop-defer / unknown at
#              zero: an unclosed *sql.Rows never returns its connection to
#              the pool, and MPM runs a single shared SQLite connection.
#   - scans    keeps silent-continue / fake-hard-fail / no-check at absolute
#              zero: the migration tripwire (test suite) depends on this
#              gate. logged-swallow / ErrNoRows-tolerated / tolerated pass
#              by design.
#
# Run only when Go files are staged, same as the per-audit loop this
# replaces. mpm-lint parses each file once and runs every rule concurrently.
if git diff --cached --name-only | grep -qE '\.go$'; then
  if ! "$GO" run ./cmd/mpm-lint --gate > "/tmp/pre-commit-mpm-lint.md" 2> "/tmp/pre-commit-mpm-lint.err"; then
    echo "[pre-commit] ABORTING commit: mpm-lint gate failed." >&2
    echo "[pre-commit] See the audit report:" >&2
    cat "/tmp/pre-commit-mpm-lint.md" >&2
    echo "[pre-commit] Gate verdict:" >&2
    cat "/tmp/pre-commit-mpm-lint.err" >&2
    rm -f "/tmp/pre-commit-mpm-lint.md" "/tmp/pre-commit-mpm-lint.err"
    exit 1
  fi
  cat "/tmp/pre-commit-mpm-lint.err" >&2
  rm -f "/tmp/pre-commit-mpm-lint.md" "/tmp/pre-commit-mpm-lint.err"
  echo "[pre-commit] mpm-lint gate OK"
fi

echo "[pre-commit] running threshold-table positive-presence gate..."
# Every MCP-output-cap constant in production source must have a peer row
# in the SPEC §6.4 threshold table. Negative (no-stale-phrase) checks are
# covered elsewhere; this is the positive check that catches future
# threshold additions/removals that bypass the table.
#
# Three rows were added as part of the same arc:
#   - mpm_blob_search serverMaxMatches (handlers.go:6119)
#   - mpm_blob_search serverMaxBytes (handlers.go:6120)
#   - maxQueryLimit (handlers.go:6240)
# Adding new threshold constants requires updating this gate's
# REQUIRED_THRESHOLDS list in lock-step — the gate is the structural
# enforcement, not a soft suggestion.
if ! bash scripts/doc-gate-threshold-table.sh > /tmp/pre-commit-doc-gate.log 2>&1; then
  echo "[pre-commit] ABORTING commit: SPEC §6.4 threshold table is missing rows." >&2
  echo "[pre-commit] Either add the missing row to docs/SPEC.md §6.4, or update" >&2
  echo "[pre-commit] scripts/doc-gate-threshold-table.sh's REQUIRED_THRESHOLDS" >&2
  echo "[pre-commit] if the constant has been removed from source." >&2
  cat /tmp/pre-commit-doc-gate.log >&2
  rm -f /tmp/pre-commit-doc-gate.log
  exit 1
fi
rm -f /tmp/pre-commit-doc-gate.log
echo "[pre-commit] threshold-table gate OK"

echo "[pre-commit] running CLI-side-limits positive-presence gate..."
# Sibling of the §6.4 threshold-table gate above: every CLI-limit
# constant in cmd/mpm/ (named byte/char caps on input or output,
# plus row-count defaults for --limit flags) must have a peer row
# in the SPEC §8 CLI-side-limits table. The two gates are kept
# deliberately separate — §6.4 and §8 are distinct surfaces in the
# SPEC's own narrative, and conflating them in tooling would blur
# a distinction the docs intentionally keep separate.
#
# Adding new CLI-limit constants requires updating this gate's
# REQUIRED_CLI_LIMITS list in lock-step — the gate is the structural
# enforcement, not a soft suggestion.
if ! bash scripts/doc-gate-cli-limits.sh > /tmp/pre-commit-cli-gate.log 2>&1; then
  echo "[pre-commit] ABORTING commit: SPEC §8 CLI-side limits table is missing rows." >&2
  echo "[pre-commit] Either add the missing row to docs/SPEC.md §8, or update" >&2
  echo "[pre-commit] scripts/doc-gate-cli-limits.sh's REQUIRED_CLI_LIMITS" >&2
  echo "[pre-commit] if the constant has been removed from source." >&2
  cat /tmp/pre-commit-cli-gate.log >&2
  rm -f /tmp/pre-commit-cli-gate.log
  exit 1
fi
rm -f /tmp/pre-commit-cli-gate.log
echo "[pre-commit] CLI-side-limits gate OK"

echo "[pre-commit] running synthesis / reliability / lifecycle / wake context tests..."
# Architecture Split (2026-07-07) moved Core from ./internal/ to ./internal/core/
# as a standalone Go module. The pre-commit gate now invokes the Makefile's
# `test-core-precommit` target rather than calling `go test` directly. This
# gives the FTS5 flag set a single source of truth: the Makefile's
# CGO_CFLAGS / CGO_LDFLAGS / -tags fts5 line. Running `go test` from the
# hook bypasses that and silently breaks on a fresh checkout (no build
# cache) because the C-level sqlite_fts5 module never gets compiled in.
#
# The previous direct-`go test` line is preserved as a comment for
# archaeology; do not resurrect it.
#
# Hit on 2026-09-02 plugin commit (96e0917): the original direct-`go test`
# invocation didn't set CGO_CFLAGS, so the gate spuriously aborted unrelated
# diffs whenever the build cache was cold. Routing through Make eliminates
# the ambient dependency on a warm cache.
#
# Earlier version (kept here for the historical record — DO NOT USE):
#   if ! (cd internal/core && "$GO" test -short -count=1 -tags fts5 ./... \
#        -run "TestSynthesis|TestReliability|TestLifecycle|TestHybrid|TestGetRecentUserTopics"); then
if ! make test-core-precommit > /tmp/pre-commit-test.log 2>&1; then
  echo "[pre-commit] ABORTING commit: migration-relevant tests failed." >&2
  echo "[pre-commit] See log:" >&2
  tail -50 /tmp/pre-commit-test.log >&2
  rm -f /tmp/pre-commit-test.log
  exit 1
fi
rm -f /tmp/pre-commit-test.log

echo "[pre-commit] running router linter (persona/mode frontmatter)..."
# The linter catches YAML escape footguns and broken regex compilation
# BEFORE the broken file is ever loaded by the runtime router. See
# lesson 9e1b2142bd525c6d for the failure mode this defends against.
# Only run if persona/ or mode/ files are staged for this commit —
# avoids slowing down unrelated commits.
if git diff --cached --name-only | grep -qE "^(persona|mode)/.*\.md$"; then
  if [ ! -x "./bin/mpm" ]; then
    echo "[pre-commit] WARN: bin/mpm not found, building..."
    if ! "$GO" build -o bin/mpm ./cmd/mpm; then
      echo "[pre-commit] ABORTING commit: could not build bin/mpm for linter." >&2
      exit 1
    fi
  fi
  if ! ./bin/mpm ops lint > /tmp/pre-commit-lint.log 2>&1; then
    echo "[pre-commit] ABORTING commit: router frontmatter lint failed." >&2
    echo "[pre-commit] Run \`mpm ops lint\` to see issues:" >&2
    cat /tmp/pre-commit-lint.log >&2
    rm -f /tmp/pre-commit-lint.log
    exit 1
  fi
  rm -f /tmp/pre-commit-lint.log
  echo "[pre-commit] linter OK"
fi

echo "[pre-commit] all checks passed — committing"
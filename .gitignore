__pycache__/
*.pyc
.vscode/
*.log

# Compiled binaries (mpm itself)
bin/

# Top-level `mpm` symlinks (used for go tooling that expects ./mpm
# in cwd). bin/ ignores its target; git won't ignore the symlinks
# themselves without explicit rules.
#
# 2026-07-16: extended from /mpm to /mpm-critic and /mpm-scheduler
# after `make build` started dropping those symlinks at the project
# root alongside the existing /mpm symlink. Without these rules,
# git status surfaces them as Untracked every build.
/mpm
/mpm-critic
/mpm-scheduler
/gen-cli

# mpm-agent is a sibling project at ../mpm-agent, not a subdir.
# Its build artifacts live in its own .gitignore. Defensive rule
# below in case the dir is ever recreated inside mpm/.
mpm-agent/

# Runtime state (never commit these)
src/db/mpm.db
src/db/mpm.db.old
src/db/mirror.jsonl
src/db/watchdog.jsonl
# Internal/core path was never covered by the src/db/ rule above — same
# runtime files live at internal/core/src/db/ when MPM is consumed as
# a library. Added 2026-08-08 after both files slipped through.
# Wildcards cover .jsonl + rotated/compressed siblings (.gz, .old, .1, etc.)
internal/core/src/db/mirror.jsonl*
internal/core/src/db/watchdog.jsonl*
# Vestigial dev-state path (was tracked via git add in early history;
# removed 2026-07-07 — see MPM lesson on vestigial cleanup).
internal/src/db/
# Scoped to repo root — the bare `config/` pattern previously also
# matched internal/core/config/, which silently excluded new config
# tests from commits.
/config/

# Backup files
mpm-backup-*.sql
src/db/mpm.db.backup-*

# SQLite WAL and shared memory files (runtime artifacts)
*.db-wal
*.db-shm
# SQLite WAL rollover files (kept after a checkpoint as a safety net;
# regenerated automatically — never commit them)
*.db.old-wal
*.db.old-shm

# Worktrees
/.worktrees

# OS artifacts
.DS_Store

# Local secrets store (chmod 600 — always private)
secrets.env

# Local config (contains secrets — always private). Matched broadly so
# accidental commits from any subdir (e.g. cmd/mpm/) are caught — the
# mpm_config.json.example template is re-included by the `!` rule below.
**/mpm_config.json
!mpm_config.json.example
mpm_config.json.bak
src/db/mirror.jsonl
src/db/mpm.db
src/db/*.jsonl
# Compressed rotated logs (log-rotation feature ships them next to jsonl).
src/db/*.gz
cmd/mpm/src/db/
mpm-mcp
*.pid
*.lock
backups/

# Working notes / plan docs (subagent-driven-development workflow).
# Plan docs under docs/superpowers/plans/ are ephemeral scaffolding for
# in-flight refactors — the git log narrates the outcome, not the plan.
# Keep the dir local; regenerate per refactor as needed.
docs/superpowers/
active.json

# Nested Go build outputs (when building inside cmd/ subdirs via
# `go build ./cmd/mpm` rather than the root-level `make build`).
# Prevents accidental commits of stale local builds that shadow
# the canonical `bin/` output.
cmd/mpm/mpm
cmd/mpm-mcp/mpm-mcp
cmd/mpm-scheduler/mpm-scheduler
cmd/mpm-critic/mpm-critic

# Top-level `audit-scans` binary (cmd/audit-scans built directly via
# `go build ./cmd/audit-scans` rather than through the bin/ pipeline).
# Audit-scans is a one-off Go analyzer; the canonical artifact is its
# source under cmd/audit-scans, not a stale root-level build.
/audit-scans

# Go test, coverage, & profiling artifacts. Coverage profiles are
# regenerated by `make test` and Go's `-coverprofile=` flag; the
# binary test outputs (`*.test`) are emitted by `go test -c`.
coverage.out
coverage.html
*.coverprofile
*.test

# Go pprof profiles. `go test -cpuprofile=cpu.out` etc. land here.
*.prof
cpu.out
mem.out

# SQLite rollback journals. WAL mode writes `*.db-wal` and `*.db-shm`
# (already covered above); standard journal mode writes `*.db-journal`.
# Belt-and-braces for queries that briefly fall back to journal mode
# during a temporary transaction rollback.
*.db-journal

# IDEs. .vscode/ is already ignored; add JetBrains (GoLand) for
# contributors who prefer it over VS Code.
.idea/

# Local tool state & agent workspaces (added 2026-08-08 pre-public cleanup).
# .openclaude/ is the OpenClaw tool's local state dir — never public.
.openclaude/
# .superpowers/ at the repo root holds the SDD framework's output (task
# reports, plan scaffolds). Distinct from docs/superpowers/ (already
# ignored above), which is the published plans directory.
.superpowers/
# workspace/ inside the repo is an agent-runtime scratchpad area.
# Currently only contains the append-only REGRET_LOG.md.
workspace/REGRET_LOG.md

# Audit & benchmark dumps from cmd/audit-scans (the static analyzer).
# These are point-in-time diff baselines — never published.
scan-audit-*.json
# Root + docs audit notes (transient devlogs, never published).
audit.md
docs/audit-*.md

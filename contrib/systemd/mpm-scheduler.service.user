[Unit]
Description=MPM universal wake executor (USER-level, alpha default)
# MPM is a headless cognitive substrate. See the project README:
#   https://github.com/flowbyte-com/mpm
#
# This is the USER-level unit and the DEFAULT install target as of
# the alpha release. install.sh installs it to
# $HOME/.config/systemd/user/mpm-scheduler.service and the install
# flow does NOT require root. The system-level alternative
# (mpm-scheduler.service.system) is reachable via `sudo ./install.sh --system`.
#
# Canonical install layout: $HOME/.mpm/bin/ for binaries, $HOME/.mpm/ for
# data + lock + backups. This service points at the canonical location;
# no /usr/local copy, no /usr/bin copy, no PATH-ordering concern.
#
# On hosts with encrypted home (ecryptfs, e.g. /home/.ecryptfs/$USER),
# this unit may silently fail at boot because user@UID.service starts
# via linger (≈08:01) before PAM unwraps ecryptfs on login (≈08:17).
# Unit files in ~/.config/systemd/user/ are inside the encrypted tree
# and are invisible until decrypt; default.target is reached at 08:01
# before they appear, so Wants= are never evaluated. Restart=on-failure
# does not recover because the failure is during initial load, not
# runtime crash. See commit 14ac32b.
# Fix installed by install.sh on ecryptfs hosts:
#   ~/.config/autostart/mpm-post-decrypt.desktop runs after decrypt:
#     systemctl --user daemon-reload; systemctl --user start mpm-scheduler
#   plus secondary: systemctl --user add-wants graphical-session.target mpm-scheduler
# RequiresMountsFor=%h documents the mount dependency but does not fix
# ecryptfs invisibility (mount is present, just encrypted).
After=default.target
RequiresMountsFor=%h

[Service]
Type=simple
# Canonical install: binaries at %h/.mpm/bin/, data at %h/.mpm/.
# The lock file lives inside the encrypted %h/.mpm/ so it is unreadable
# pre-decrypt (the Lazy-Start Architecture's safety property).
WorkingDirectory=%h/.mpm
ExecStart=%h/.mpm/bin/mpm-scheduler --interval 60s --log-level info --lock %h/.mpm/scheduler.lock

# Runtime paths
Environment=MPM_WORKSPACE=%h/.mpm
Environment=MPM_DB_PATH=%h/.mpm/src/db/mpm.db
Environment=MPM_BACKUP_DIR=%h/.mpm/backups/critic-pre
Environment=MPM_CRITIC_BIN=%h/.mpm/bin/mpm-critic

EnvironmentFile=-%h/.config/mpm/mpm.env

# Hardening (light — tighten further as your security model demands)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# Only %h/.mpm is writable (data + lock + backups). Binaries are
# read-only under the canonical install.
ReadWritePaths=%h/.mpm
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mpm-scheduler

[Install]
WantedBy=default.target
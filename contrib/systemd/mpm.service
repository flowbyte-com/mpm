# MPM Watcher Systemd Unit
#
# Installation:
#   1. Copy to /etc/systemd/system/mpm.service
#      sudo cp mpm.service /etc/systemd/system/
#
#   2. Ensure the mpm binary is installed at the path below (or edit ExecStart)
#      sudo make install BIN=mpm   # installs to /usr/local/bin/mpm
#
#   3. Enable and start
#      sudo systemctl daemon-reload
#      sudo systemctl enable mpm
#      sudo systemctl start mpm
#
#   4. Check status
#      systemctl status mpm
#      journalctl -u mpm -f
#
# Notes:
#   - The mpm binary resolves its workspace via MPM_WORKSPACE or ~/.mpm automatically.
#     No environment or path configuration needed in systemd.
#   - Do NOT use --bg flag. systemd tracks the process lifecycle directly.
#     The mpm binary runs in foreground mode and systemd manages it as a service.
#   - Logs go to journalctl (not a log file). Use `journalctl -u mpm` to view.
#   - On stop, mpm sends SIGTERM to the watcher which performs graceful shutdown
#     (drains pool, cleans PID file, exits cleanly).

[Unit]
Description=MPM Memory-Persona-Mode Manager (File Watcher)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/v/workspace/projects/mpm
ExecStart=/usr/local/bin/mpm watch start
Restart=on-failure
RestartSec=5
User=v

# Hardening: limit privileges
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
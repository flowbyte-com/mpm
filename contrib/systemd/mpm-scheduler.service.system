[Unit]
Description=MPM universal wake executor (SYSTEM-level, opt-in)
# MPM is a headless cognitive substrate. See the project README:
#   https://github.com/flowbyte-com/mpm
#
# This is the SYSTEM-level unit. It is installed by `scripts/install.sh --system`
# to /etc/systemd/system/ and boots with the machine, independent of
# session/encryption state. It is the OPT-IN install target for shared
# hosts (e.g., dedicated headless VMs where shared system state is intentional).
#
# The DEFAULT install target is user-level (no sudo, $HOME/.mpm/bin/ for
# binaries, $HOME/.mpm/ for data) — see ./mpm-scheduler.service.user in
# this directory. User-level silently fails on hosts with encrypted
# home directories (eCryptfs/LUKS) — see lesson id 071911bc in MPM —
# which is why this system-level alternative exists.
#
# System mode is the ONLY mode that places binaries in /usr/local/bin/.
# User mode keeps everything under $HOME/.mpm/ — see INSTALL.md for the
# alpha install contract.
After=multi-user.target

[Service]
Type=simple
# User=v / Group=v are substituted by scripts/install.sh at install time
# to match the invoking user (SUDO_USER). They are hardcoded to 'v'
# here as a fallback for systems where the unit is installed manually.
User=v
Group=v
WorkingDirectory=/var/lib/mpm
ExecStart=/usr/local/bin/mpm-scheduler --interval 60s --log-level info --lock /var/lib/mpm/scheduler.lock

# Runtime paths — see scripts/install.sh for source-of-truth.
Environment=MPM_WORKSPACE=/var/lib/mpm
Environment=MPM_DB_PATH=/var/lib/mpm/src/db/mpm.db
Environment=MPM_BACKUP_DIR=/var/lib/mpm/backups/critic-pre
Environment=MPM_CRITIC_BIN=/usr/local/bin/mpm-critic

# Restart=always (NOT on-failure) — the daemon may exit cleanly during
# normal operation; we want it to come back regardless. RestartSec=5s
# gives the lock + DB a chance to clear before retry.
Restart=always
RestartSec=5s

# Hardening (light — tighten further as your security model demands)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# Only /var/lib/mpm is writable. The DB, lock file, backups all live here.
ReadWritePaths=/var/lib/mpm

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mpm-scheduler

[Install]
WantedBy=multi-user.target
